        "crypto-js": "^4.2.0",
        "echarts": "^5.5.1",
        "lodash": "^4.17.21",
        "next": "14.2.6",
        "next-auth": "^4.24.8",
        "pg": "^8.12.0",
        "prisma": "^5.20.0",
