   generator client {
     provider = "prisma-client-js"
   }

   datasource db {
     provider = "postgresql"
     url      = env("POSTGRES_PRISMA_URL") // 使用连接池
     directUrl = env("POSTGRES_URL_NON_POOLING") // 使用直接连接
   }

  model users_info {
    user_id    String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
    username   String    @unique @db.VarChar(50)
    email      String?   @db.VarChar(100)
    created_at DateTime? @default(now()) @db.Timestamp(6)
    update_at  DateTime? @db.Timestamp(6)
    is_deleted String?   @db.Char(1)
    users_pwd  users_pwd?
    user_role  user_role?
  }

  model users_pwd {
    user_id  String     @id @db.Uuid
    salt     String     @db.VarChar(50)
    hash_pwd String     @db.VarChar(100)
    user     users_info @relation(fields: [user_id], references: [user_id])
  }

  model user_role {
    user_id    String     @id @db.Uuid
    role       String     @db.VarChar(20)
    created_at DateTime   @default(now()) @db.Timestamp(6)
    updated_at DateTime   @updatedAt @db.Timestamp(6)
    user       users_info @relation(fields: [user_id], references: [user_id])
  }
